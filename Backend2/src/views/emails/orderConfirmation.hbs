<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta http-equiv="X-UA-Compatible" content="IE=edge" />
  <title>Order Confirmed — Naisha Creations</title>
  <!--[if mso]>
  <noscript>
    <xml>
      <o:OfficeDocumentSettings>
        <o:PixelsPerInch>96</o:PixelsPerInch>
      </o:OfficeDocumentSettings>
    </xml>
  </noscript>
  <![endif]-->
  <style>
    @import url('https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;1,400;1,500&family=Jost:wght@300;400;500;600&display=swap');

    * { margin: 0; padding: 0; box-sizing: border-box; }

    body {
      font-family: 'Jost', 'Helvetica Neue', Helvetica, Arial, sans-serif;
      background-color: #f7f3ee;
      color: #2c2118;
      -webkit-font-smoothing: antialiased;
    }

    .email-wrapper {
      width: 100%;
      background-color: #f7f3ee;
      padding: 40px 16px;
    }

    .email-container {
      max-width: 600px;
      margin: 0 auto;
      background-color: #fffdf9;
    }

    /* ── HEADER ── */
    .header {
      background-color: #5e3232;
      text-align: center;
    }

    .header-logo-area {
      padding: 28px 0 0 0;
      text-align: center;
    }

    .header-logo-area img {
      display: block;
      width: 100%;
      max-width: 600px;
      height: auto;
      margin: 0 auto;
    }

    .header-inner {
      padding: 28px 30px 40px;
    }

    .header-title {
      font-family: 'Cormorant Garamond', Georgia, serif;
      font-size: 38px;
      font-weight: 500;
      font-style: italic;
      color: #f5ede3;
      line-height: 1.2;
      letter-spacing: 1px;
      margin-bottom: 10px;
    }

    .header-subtitle {
      font-family: 'Jost', sans-serif;
      font-size: 12px;
      font-weight: 500;
      letter-spacing: 3px;
      text-transform: uppercase;
      color: #c9a882;
    }

    /* ── CONTENT ── */
    .content {
      padding: 52px 48px;
    }

    .greeting {
      font-family: 'Cormorant Garamond', Georgia, serif;
      font-size: 30px;
      font-weight: 500;
      color: #2c2118;
      margin-bottom: 16px;
      line-height: 1.3;
    }

    .intro-text {
      font-size: 15px;
      font-weight: 300;
      color: #7a6555;
      line-height: 1.9;
      margin-bottom: 40px;
    }

    /* ── SECTION LABEL ── */
    .section-label {
      font-size: 11px;
      font-weight: 600;
      letter-spacing: 3px;
      text-transform: uppercase;
      color: #b8a090;
      margin-bottom: 18px;
      padding-bottom: 12px;
      border-bottom: 1px solid #f0e8de;
    }

    /* ── ITEMS TABLE ── */
    .items-section {
      margin-bottom: 36px;
    }

    .items-table {
      width: 100%;
      border-collapse: collapse;
    }

    .items-table th {
      text-align: left;
      font-size: 11px;
      font-weight: 600;
      letter-spacing: 2px;
      text-transform: uppercase;
      color: #b8a090;
      padding-bottom: 14px;
      border-bottom: 1px solid #ede5da;
    }

    .items-table th.align-center { text-align: center; }
    .items-table th.align-right  { text-align: right; }

    .items-table td {
      padding: 20px 0;
      border-bottom: 1px solid #f5ede4;
      vertical-align: top;
    }

    .item-name {
      font-family: 'Cormorant Garamond', Georgia, serif;
      font-size: 18px;
      font-weight: 600;
      color: #2c2118;
      margin-bottom: 5px;
    }

    .item-meta {
      font-size: 13px;
      font-weight: 300;
      color: #9e8878;
      letter-spacing: 0.5px;
    }

    .item-qty {
      text-align: center;
      font-size: 15px;
      font-weight: 400;
      color: #7a6555;
    }

    .item-price {
      text-align: right;
      font-size: 15px;
      font-weight: 500;
      color: #2c2118;
      white-space: nowrap;
    }

    /* ── SUMMARY ── */
    .summary-section {
      margin-bottom: 40px;
    }

    .summary-total-label {
      font-family: 'Cormorant Garamond', Georgia, serif;
      font-size: 22px;
      font-weight: 600;
      color: #2c2118;
      letter-spacing: 1px;
    }

    .summary-total-value {
      font-family: 'Cormorant Garamond', Georgia, serif;
      font-size: 24px;
      font-weight: 600;
      color: #8b4a3a;
      letter-spacing: 1px;
    }

    /* ── NOTICE BOX ── */
    .notice-box {
      background-color: #fdf3ec;
      border-left: 3px solid #c9a882;
      padding: 20px 22px;
      margin-bottom: 44px;
    }

    .notice-text {
      font-size: 13px;
      font-weight: 300;
      color: #7a6555;
      line-height: 1.9;
    }

    .notice-text strong {
      font-weight: 600;
      color: #5a3a28;
    }

    /* ── CTA BUTTON ── */
    .btn {
      display: inline-block;
      padding: 16px 44px;
      background-color: #3d1f1f;
      color: #f5ede3 !important;
      text-decoration: none;
      font-size: 12px;
      font-weight: 600;
      letter-spacing: 3px;
      text-transform: uppercase;
    }

    /* ── FOOTER ── */
    .footer {
      padding: 40px 48px;
      text-align: center;
    }

    .footer-brand {
      font-family: 'Cormorant Garamond', Georgia, serif;
      font-size: 20px;
      font-weight: 500;
      font-style: italic;
      color: #3d1f1f;
      letter-spacing: 2px;
      margin-bottom: 14px;
    }

    .footer-tagline {
      font-size: 11px;
      font-weight: 300;
      letter-spacing: 2px;
      text-transform: uppercase;
      color: #b8a090;
      margin-bottom: 24px;
    }

    .footer-legal {
      font-size: 12px;
      font-weight: 300;
      color: #b8a090;
      line-height: 1.9;
    }

    .footer-legal a {
      color: #9e7a60;
      text-decoration: none;
    }

    .social-icon-link {
      display: inline-block;
      width: 36px;
      height: 36px;
      line-height: 34px;
      text-align: center;
      border: 1px solid #d4c4b0;
      border-radius: 50%;
      color: #7a5c3a;
      text-decoration: none;
      font-size: 16px;
      margin: 0 8px;
    }
  </style>
</head>
<body>
  <div class="email-wrapper">
    <!-- Outer wrapper table for centering -->
    <table width="100%" cellpadding="0" cellspacing="0" border="0">
      <tr>
        <td align="center">
          <!-- Email container -->
          <table class="email-container" width="600" cellpadding="0" cellspacing="0" border="0" style="max-width:600px;background-color:#fffdf9;">

            <!-- ── HEADER ── -->
            <tr>
              <td style="background-color:#5e3232;padding-top:28px;" align="center">
                <!-- Logo: full width, no side padding -->
                <img src="{{logoUrl}}" alt="Naisha Creations" width="600" style="display:block;width:100%;max-width:600px;height:auto;" />
              </td>
            </tr>
            <tr>
              <td style="background-color:#5e3232;padding:24px 30px 40px;" align="center">
                <!-- Divider using table, no flex -->
                <table width="100%" cellpadding="0" cellspacing="0" border="0" style="margin-bottom:22px;">
                  <tr>
                    <td width="80" style="padding-right:12px;">
                      <!-- gradient line via a 1px tall td with background -->
                      <table width="100%" cellpadding="0" cellspacing="0" border="0"><tr>
                        <td height="1" style="background:linear-gradient(90deg,transparent,#c9a882);font-size:1px;line-height:1px;">&nbsp;</td>
                      </tr></table>
                    </td>
                    <td width="20" align="center" style="color:#c9a882;font-size:16px;white-space:nowrap;">✦</td>
                    <td width="80" style="padding-left:12px;">
                      <table width="100%" cellpadding="0" cellspacing="0" border="0"><tr>
                        <td height="1" style="background:linear-gradient(90deg,#c9a882,transparent);font-size:1px;line-height:1px;">&nbsp;</td>
                      </tr></table>
                    </td>
                  </tr>
                </table>
                <h1 class="header-title" style="font-family:'Cormorant Garamond',Georgia,serif;font-size:42px;font-weight:500;font-style:italic;color:#f5ede3;line-height:1.2;letter-spacing:1px;margin-bottom:10px;">Order Confirmed</h1>
                <p class="header-subtitle" style="font-family:'Jost',sans-serif;font-size:12px;font-weight:500;letter-spacing:3px;text-transform:uppercase;color:#c9a882;">Handcrafted with love &nbsp;&middot;&nbsp; Packed with care</p>
              </td>
            </tr>

            <!-- ── BODY ── -->
            <tr>
              <td class="content" style="padding:52px 48px;">

                <h2 class="greeting" style="font-family:'Cormorant Garamond',Georgia,serif;font-size:30px;font-weight:500;color:#2c2118;margin-bottom:16px;line-height:1.3;">Thank you, {{firstName}}! &#x1F56F;&#xFE0F;</h2>
                <p class="intro-text" style="font-size:15px;font-weight:300;color:#7a6555;line-height:1.9;margin-bottom:40px;">
                  Your order has been received and our artisans are already getting to work. Each piece is made with intention &mdash;
                  we&rsquo;ll send you a shipping confirmation with tracking details once your order is on its way.
                </p>

                <!-- Order ID — table layout -->
                <table width="100%" cellpadding="0" cellspacing="0" border="0" style="border:1px solid #e8ddd2;background-color:#fdf8f3;margin-bottom:44px;">
                  <tr>
                    <td style="padding:22px 26px;">
                      <p style="font-size:11px;font-weight:600;letter-spacing:2.5px;text-transform:uppercase;color:#b8a090;margin-bottom:5px;">Order Number</p>
                      <p style="font-family:'Cormorant Garamond',Georgia,serif;font-size:24px;font-weight:600;color:#3d1f1f;letter-spacing:1px;">#{{orderId}}</p>
                    </td>
                    <td align="right" style="padding:22px 26px;">
                      <span style="background-color:#f0ebe2;border:1px solid #d4c4b0;border-radius:20px;padding:7px 16px;font-size:12px;font-weight:600;letter-spacing:1.5px;text-transform:uppercase;color:#7a5c3a;">Confirmed</span>
                    </td>
                  </tr>
                </table>

                <!-- Items -->
                <div class="items-section">
                  <p class="section-label">Your Items</p>
                  <table class="items-table" width="100%" cellpadding="0" cellspacing="0">
                    <thead>
                      <tr>
                        <th style="text-align:left;font-size:11px;font-weight:600;letter-spacing:2px;text-transform:uppercase;color:#b8a090;padding-bottom:14px;border-bottom:1px solid #ede5da;">Item</th>
                        <th style="text-align:center;font-size:11px;font-weight:600;letter-spacing:2px;text-transform:uppercase;color:#b8a090;padding-bottom:14px;border-bottom:1px solid #ede5da;">Qty</th>
                        <th style="text-align:right;font-size:11px;font-weight:600;letter-spacing:2px;text-transform:uppercase;color:#b8a090;padding-bottom:14px;border-bottom:1px solid #ede5da;">Price</th>
                      </tr>
                    </thead>
                    <tbody>
                      {{#each items}}
                      <tr>
                        <td style="padding:20px 0;border-bottom:1px solid #f5ede4;vertical-align:top;">
                          <p class="item-name">{{this.name}}</p>
                          <p class="item-meta">{{this.type}}</p>
                        </td>
                        <td class="item-qty" style="padding:20px 0;border-bottom:1px solid #f5ede4;vertical-align:top;text-align:center;font-size:15px;font-weight:400;color:#7a6555;">{{this.quantity}}</td>
                        <td class="item-price" style="padding:20px 0;border-bottom:1px solid #f5ede4;vertical-align:top;text-align:right;font-size:15px;font-weight:500;color:#2c2118;white-space:nowrap;">&#8377;{{this.price}}</td>
                      </tr>
                      {{/each}}
                    </tbody>
                  </table>
                </div>

                <!-- Summary -->
                <div class="summary-section">
                  <table width="100%" cellpadding="0" cellspacing="0" border="0">
                    <tr>
                      <td style="padding:9px 0;font-size:14px;font-weight:300;color:#7a6555;">Subtotal</td>
                      <td align="right" style="padding:9px 0;font-size:14px;font-weight:300;color:#7a6555;">&#8377;{{subtotal}}</td>
                    </tr>
                    <tr>
                      <td style="padding:9px 0;font-size:14px;font-weight:300;color:#7a6555;">Shipping</td>
                      <td align="right" style="padding:9px 0;font-size:14px;font-weight:300;color:#7a6555;">&#8377;{{shippingPrice}}</td>
                    </tr>
                    {{#if discount}}
                    <tr>
                      <td style="padding:9px 0;font-size:14px;font-weight:500;color:#7a9e78;">Discount Applied</td>
                      <td align="right" style="padding:9px 0;font-size:14px;font-weight:500;color:#7a9e78;">&minus; &#8377;{{discount}}</td>
                    </tr>
                    {{/if}}
                    <tr>
                      <td colspan="2" style="padding:0;"><hr style="border:none;border-top:1.5px solid #2c2118;margin:8px 0 0;" /></td>
                    </tr>
                    <tr>
                      <td style="padding-top:16px;">
                        <span class="summary-total-label" style="font-family:'Cormorant Garamond',Georgia,serif;font-size:22px;font-weight:600;color:#2c2118;letter-spacing:1px;">Total</span>
                      </td>
                      <td align="right" style="padding-top:16px;">
                        <span class="summary-total-value" style="font-family:'Cormorant Garamond',Georgia,serif;font-size:26px;font-weight:600;color:#8b4a3a;letter-spacing:1px;">&#8377;{{total}}</span>
                      </td>
                    </tr>
                    {{#if paymentStatusLabel}}
                    <tr>
                      <td colspan="2" align="right" style="padding-top:12px;">
                        <span style="font-size:12px;font-weight:600;letter-spacing:1px;text-transform:uppercase;padding:5px 12px;border-radius:12px;display:inline-block;{{#if isPaid}}background-color:#eaf5ea;color:#2e7d32;border:1px solid #c8e6c9;{{else}}background-color:#fff3e0;color:#e65100;border:1px solid #ffe0b2;{{/if}}">
                          {{paymentStatusLabel}} ({{paymentMethodLabel}})
                        </span>
                      </td>
                    </tr>
                    {{/if}}
                  </table>
                </div>

                <!-- Shipping Address — table layout -->
                <p class="section-label" style="margin-bottom:18px;">Delivering To</p>
                <table width="100%" cellpadding="0" cellspacing="0" border="0" style="background-color:#fdf8f3;border:1px solid #ede5da;margin-bottom:40px;">
                  <tr>
                    <td style="padding:24px 26px;vertical-align:top;width:36px;font-size:22px;">&#128230;</td>
                    <td style="padding:24px 26px 24px 0;vertical-align:top;">
                      <p style="font-family:'Cormorant Garamond',Georgia,serif;font-size:19px;font-weight:600;color:#2c2118;margin-bottom:7px;">{{shippingAddress.firstName}} {{shippingAddress.lastName}}</p>
                      <p style="font-size:14px;font-weight:300;color:#7a6555;line-height:1.9;">
                        {{shippingAddress.address}}<br />
                        {{shippingAddress.city}}, {{shippingAddress.state}} &mdash; {{shippingAddress.pincode}}<br />
                        &#128222; {{shippingAddress.phone}}
                      </p>
                    </td>
                  </tr>
                </table>

                <!-- Policy Notice -->
                <div class="notice-box" style="background-color:#fdf3ec;border-left:3px solid #c9a882;padding:20px 22px;margin-bottom:44px;">
                  <p class="notice-text" style="font-size:13px;font-weight:300;color:#7a6555;line-height:1.9;">
                    <strong style="font-weight:600;color:#5a3a28;">Please note:</strong> Orders are processed within <strong style="font-weight:600;color:#5a3a28;">2&ndash;5 business days</strong>.
                    Customised or bulk orders may take additional time. Once dispatched via Shiprocket,
                    transit delays or damages are subject to the courier&rsquo;s policy.
                    For wrong item concerns, contact us within <strong style="font-weight:600;color:#5a3a28;">24 hours of delivery</strong> with unboxing photos and video.
                  </p>
                </div>

                <!-- CTA -->
                <table width="100%" cellpadding="0" cellspacing="0" border="0" style="margin-bottom:8px;">
                  <tr>
                    <td align="center">
                      <a href="{{trackingUrl}}" class="btn" style="display:inline-block;padding:16px 44px;background-color:#3d1f1f;color:#f5ede3;text-decoration:none;font-size:12px;font-weight:600;letter-spacing:3px;text-transform:uppercase;">Track Your Order</a>
                    </td>
                  </tr>
                </table>

              </td>
            </tr>

            <!-- ── FOOTER DIVIDER ── -->
            <tr>
              <td style="padding:0 48px;">
                <hr style="border:none;border-top:1px solid #e0d2c2;" />
              </td>
            </tr>

            <!-- ── FOOTER ── -->
            <tr>
              <td class="footer" style="padding:40px 48px;text-align:center;">
                <p class="footer-brand" style="font-family:'Cormorant Garamond',Georgia,serif;font-size:20px;font-weight:500;font-style:italic;color:#3d1f1f;letter-spacing:2px;margin-bottom:14px;">Naisha Creations</p>
                <p class="footer-tagline" style="font-size:11px;font-weight:300;letter-spacing:2px;text-transform:uppercase;color:#b8a090;margin-bottom:24px;">Handcrafted &middot; Thoughtful &middot; Made with love</p>

                <!-- Social links: Unicode emoji icons in bordered circles via table -->
                <table cellpadding="0" cellspacing="0" border="0" style="margin:0 auto 24px;">
                  <tr>
                    <td style="padding:0 8px;">
                      <a href="https://instagram.com/naishacreations_withlove" style="display:inline-block;width:38px;height:38px;line-height:36px;text-align:center;border:1px solid #d4c4b0;border-radius:50%;color:#7a5c3a;text-decoration:none;font-size:18px;" title="Instagram">&#128247;</a>
                    </td>
                    <td style="padding:0 8px;">
                      <a href="https://naishacreations.com" style="display:inline-block;width:38px;height:38px;line-height:36px;text-align:center;border:1px solid #d4c4b0;border-radius:50%;color:#7a5c3a;text-decoration:none;font-size:18px;" title="Website">&#127760;</a>
                    </td>
                  </tr>
                </table>

                <p class="footer-legal" style="font-size:12px;font-weight:300;color:#b8a090;line-height:1.9;">
                  &copy; {{year}} Naisha Creations. All rights reserved.<br />
                  Questions? Reply to this email or write to us at
                  <a href="mailto:support@naishacreations.com" style="color:#9e7a60;text-decoration:none;">support@naishacreations.com</a>
                </p>
              </td>
            </tr>

          </table><!-- /email-container -->
        </td>
      </tr>
    </table><!-- /outer wrapper -->
  </div>
</body>
</html>