<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta http-equiv="X-UA-Compatible" content="IE=edge" />
  <title>Welcome to Naisha Creations</title>
  <!--[if mso]>
  <noscript>
    <xml>
      <o:OfficeDocumentSettings>
        <o:PixelsPerInch>96</o:PixelsPerInch>
      </o:OfficeDocumentSettings>
    </xml>
  </noscript>
  <![endif]-->
  <style>
    @import url('https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;1,400;1,500&family=Jost:wght@300;400;500;600&display=swap');

    * { margin: 0; padding: 0; box-sizing: border-box; }

    body {
      font-family: 'Jost', 'Helvetica Neue', Helvetica, Arial, sans-serif;
      background-color: #f7f3ee;
      color: #2c2118;
      -webkit-font-smoothing: antialiased;
    }

    .email-wrapper {
      width: 100%;
      background-color: #f7f3ee;
      padding: 40px 16px;
    }

    .email-container {
      max-width: 600px;
      margin: 0 auto;
      background-color: #fffdf9;
      border-radius: 2px;
      overflow: hidden;
      box-shadow: 0 2px 40px rgba(94, 50, 30, 0.08);
    }

    /* ── HEADER ── */
    .header {
      background-color: #3d1f1f;
      text-align: center;
    }

    .header-inner {
      padding: 44px 30px 40px;
    }

    .header-logo-area img {
      max-width: 220px;
      height: auto;
      display: block;
      margin: 0 auto 28px;
    }

    .header-divider {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 12px;
      margin-bottom: 22px;
    }

    .header-divider-line {
      display: inline-block;
      width: 60px;
      height: 1px;
      background: linear-gradient(90deg, transparent, #c9a882);
    }

    .header-divider-line.right {
      background: linear-gradient(90deg, #c9a882, transparent);
    }

    .header-divider-icon {
      color: #c9a882;
      font-size: 16px;
    }

    .header-title {
      font-family: 'Cormorant Garamond', Georgia, serif;
      font-size: 38px;
      font-weight: 500;
      font-style: italic;
      color: #f5ede3;
      line-height: 1.2;
      letter-spacing: 1px;
      margin-bottom: 10px;
    }

    .header-subtitle {
      font-family: 'Jost', sans-serif;
      font-size: 11px;
      font-weight: 500;
      letter-spacing: 3px;
      text-transform: uppercase;
      color: #c9a882;
    }

    /* ── HERO BAND ── */
    .hero-band {
      background-color: #f0e8de;
      padding: 28px 30px;
      text-align: center;
      border-bottom: 1px solid #e8ddd2;
    }

    .hero-icons {
      font-size: 28px;
      letter-spacing: 10px;
      display: block;
      margin-bottom: 10px;
    }

    .hero-band-text {
      font-size: 11px;
      font-weight: 500;
      letter-spacing: 3px;
      text-transform: uppercase;
      color: #9e7a60;
    }

    /* ── CONTENT ── */
    .content {
      padding: 48px 44px;
      text-align: center;
    }

    @media (max-width: 480px) {
      .content { padding: 36px 24px; }
    }

    .greeting {
      font-family: 'Cormorant Garamond', Georgia, serif;
      font-size: 30px;
      font-weight: 500;
      color: #2c2118;
      margin-bottom: 16px;
      line-height: 1.3;
    }

    .greeting em {
      font-style: italic;
      color: #8b4a3a;
    }

    .intro-text {
      font-size: 14px;
      font-weight: 300;
      color: #7a6555;
      line-height: 1.9;
      margin-bottom: 44px;
      max-width: 460px;
      margin-left: auto;
      margin-right: auto;
    }

    /* ── FEATURES ── */
    .features-section {
      margin-bottom: 44px;
    }

    .section-label {
      font-size: 10px;
      font-weight: 600;
      letter-spacing: 3px;
      text-transform: uppercase;
      color: #b8a090;
      margin-bottom: 28px;
      padding-bottom: 10px;
      border-bottom: 1px solid #f0e8de;
      text-align: left;
    }

    .features-grid {
      display: table;
      width: 100%;
      border-collapse: separate;
      border-spacing: 0;
    }

    .feature-cell {
      display: table-cell;
      width: 33.33%;
      padding: 28px 16px;
      text-align: center;
      vertical-align: top;
      background-color: #fdf8f3;
      border: 1px solid #ede5da;
    }

    .feature-cell:first-child {
      border-right: none;
    }

    .feature-cell:last-child {
      border-left: none;
    }

    .feature-icon {
      font-size: 26px;
      display: block;
      margin-bottom: 12px;
    }

    .feature-title {
      font-family: 'Cormorant Garamond', Georgia, serif;
      font-size: 15px;
      font-weight: 600;
      color: #2c2118;
      margin-bottom: 6px;
      letter-spacing: 0.5px;
    }

    .feature-desc {
      font-size: 11px;
      font-weight: 300;
      color: #9e8878;
      line-height: 1.6;
      letter-spacing: 0.3px;
    }

    /* ── ACCOUNT READY BOX ── */
    .account-box {
      background: linear-gradient(135deg, #fdf3ec, #fdf8f3);
      border-left: 3px solid #c9a882;
      border-radius: 0 2px 2px 0;
      padding: 20px 22px;
      margin-bottom: 40px;
      text-align: left;
    }

    .account-box-title {
      font-family: 'Cormorant Garamond', Georgia, serif;
      font-size: 16px;
      font-weight: 600;
      color: #3d1f1f;
      margin-bottom: 8px;
    }

    .account-box-list {
      list-style: none;
      padding: 0;
      margin: 0;
    }

    .account-box-list li {
      font-size: 13px;
      font-weight: 300;
      color: #7a6555;
      line-height: 1.8;
      padding-left: 16px;
      position: relative;
    }

    .account-box-list li::before {
      content: '✦';
      position: absolute;
      left: 0;
      font-size: 8px;
      color: #c9a882;
      top: 5px;
    }

    /* ── CTA ── */
    .btn-container {
      text-align: center;
      margin-bottom: 8px;
    }

    .btn {
      display: inline-block;
      padding: 15px 40px;
      background-color: #3d1f1f;
      color: #f5ede3 !important;
      text-decoration: none;
      font-size: 11px;
      font-weight: 600;
      letter-spacing: 3px;
      text-transform: uppercase;
      border-radius: 1px;
    }

    /* ── FOOTER ── */
    .footer-divider {
      height: 1px;
      background: linear-gradient(90deg, transparent, #e0d2c2, transparent);
      margin: 0 44px;
    }

    .footer {
      padding: 36px 44px;
      text-align: center;
    }

    .footer-brand {
      font-family: 'Cormorant Garamond', Georgia, serif;
      font-size: 18px;
      font-weight: 500;
      font-style: italic;
      color: #3d1f1f;
      letter-spacing: 2px;
      margin-bottom: 16px;
    }

    .footer-tagline {
      font-size: 11px;
      font-weight: 300;
      letter-spacing: 2px;
      text-transform: uppercase;
      color: #b8a090;
      margin-bottom: 24px;
    }

    .social-links {
      margin-bottom: 20px;
    }

    .social-links a {
      display: inline-block;
      font-size: 11px;
      font-weight: 600;
      letter-spacing: 2px;
      text-transform: uppercase;
      color: #5a3a28;
      text-decoration: none;
      margin: 0 14px;
    }

    .footer-legal {
      font-size: 11px;
      font-weight: 300;
      color: #b8a090;
      line-height: 1.8;
    }

    .footer-legal a {
      color: #9e7a60;
      text-decoration: none;
    }
  </style>
</head>
<body>
  <div class="email-wrapper">
    <div class="email-container">

      <!-- ── HEADER ── -->
      <div class="header">
        <div class="header-inner">
          <div class="header-logo-area">
            <img src="{{logoUrl}}" alt="Naisha Creations" width="220" />
          </div>
          <div class="header-divider">
            <span class="header-divider-line"></span>
            <span class="header-divider-icon">✦</span>
            <span class="header-divider-line right"></span>
          </div>
          <h1 class="header-title">Welcome to the Family</h1>
          <p class="header-subtitle">Where every flame tells a story</p>
        </div>
      </div>

      <!-- ── HERO BAND ── -->
      <div class="hero-band">
        <span class="hero-icons">🕯️&nbsp;&nbsp;✨&nbsp;&nbsp;🌿</span>
        <p class="hero-band-text">Hand-poured &nbsp;·&nbsp; Small batch &nbsp;·&nbsp; Made with love</p>
      </div>

      <!-- ── BODY ── -->
      <div class="content">

        <h2 class="greeting">So glad you're here, <em>{{firstName}}</em>!</h2>
        <p class="intro-text">
          At Naisha Creations, every candle is hand-poured with intention — crafted to bring warmth, 
          quiet, and beautiful fragrance into your everyday spaces. We're so happy to have you with us.
        </p>

        <!-- Features -->
        <div class="features-section">
          <p class="section-label">What makes us different</p>
          <div class="features-grid">
            <div class="feature-cell">
              <span class="feature-icon">✨</span>
              <p class="feature-title">Hand-Poured</p>
              <p class="feature-desc">Each candle crafted individually, never mass-produced</p>
            </div>
            <div class="feature-cell">
              <span class="feature-icon">🌿</span>
              <p class="feature-title">Premium Wax</p>
              <p class="feature-desc">Clean-burning, skin-safe ingredients in every batch</p>
            </div>
            <div class="feature-cell">
              <span class="feature-icon">🎨</span>
              <p class="feature-title">Customisable</p>
              <p class="feature-desc">Bespoke scents, labels, and gifting options available</p>
            </div>
          </div>
        </div>

        <!-- Account perks -->
        <div class="account-box">
          <p class="account-box-title">Your account is all set up</p>
          <ul class="account-box-list">
            <li>Track all your orders in one place</li>
            <li>Save your favourite delivery addresses</li>
            <li>Request custom and bulk orders with ease</li>
            <li>Get early access to new collections &amp; offers</li>
          </ul>
        </div>

        <!-- CTA -->
        <div class="btn-container">
          <a href="{{frontendUrl}}/collections" class="btn">Shop Our Collection</a>
        </div>

      </div>

      <!-- ── FOOTER DIVIDER ── -->
      <div class="footer-divider"></div>

      <!-- ── FOOTER ── -->
      <div class="footer">
        <p class="footer-brand">Naisha Creations</p>
        <p class="footer-tagline">Handcrafted · Thoughtful · Made with love</p>

        <div class="social-links">
          <a href="https://instagram.com/naishacreations_withlove">Instagram</a>
          <a href="{{frontendUrl}}">Website</a>
        </div>

        <p class="footer-legal">
          © {{year}} Naisha Creations. All rights reserved.<br />
          Questions? Reply to this email or write to us at
          <a href="mailto:support@naishacreations.com">support@naishacreations.com</a>
        </p>
      </div>

    </div>
  </div>
</body>
</html>
