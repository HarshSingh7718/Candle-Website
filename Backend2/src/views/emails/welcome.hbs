<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta http-equiv="X-UA-Compatible" content="IE=edge" />
  <title>Welcome to Naisha Creations</title>
  <!--[if mso]>
  <noscript>
    <xml>
      <o:OfficeDocumentSettings>
        <o:PixelsPerInch>96</o:PixelsPerInch>
      </o:OfficeDocumentSettings>
    </xml>
  </noscript>
  <![endif]-->
  <style>
    @import url('https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;1,400;1,500&family=Jost:wght@300;400;500;600&display=swap');

    * { margin: 0; padding: 0; box-sizing: border-box; }

    body {
      font-family: 'Jost', 'Helvetica Neue', Helvetica, Arial, sans-serif;
      background-color: #f7f3ee;
      color: #2c2118;
      -webkit-font-smoothing: antialiased;
    }

    .email-wrapper {
      width: 100%;
      background-color: #f7f3ee;
      padding: 40px 16px;
    }

    .item-name {
      font-family: 'Cormorant Garamond', Georgia, serif;
      font-size: 18px;
      font-weight: 600;
      color: #2c2118;
      margin-bottom: 5px;
    }

    .item-meta {
      font-size: 13px;
      font-weight: 300;
      color: #9e8878;
      letter-spacing: 0.5px;
    }

    .greeting em {
      font-style: italic;
      color: #8b4a3a;
    }

    .footer-legal {
      font-size: 12px;
      font-weight: 300;
      color: #b8a090;
      line-height: 1.9;
    }

    .footer-legal a {
      color: #9e7a60;
      text-decoration: none;
    }
  </style>
</head>
<body>
  <div class="email-wrapper">
    <!-- Outer wrapper table -->
    <table width="100%" cellpadding="0" cellspacing="0" border="0">
      <tr>
        <td align="center">
          <!-- Email container -->
          <table width="600" cellpadding="0" cellspacing="0" border="0" style="max-width:600px;background-color:#fffdf9;">

            <!-- ── HEADER ── -->
            <tr>
              <td style="background-color:#5e3232;padding-top:28px;" align="center">
                <img src="{{logoUrl}}" alt="Naisha Creations" width="600" style="display:block;width:100%;max-width:600px;height:auto;" />
              </td>
            </tr>
            <tr>
              <td style="background-color:#5e3232;padding:24px 30px 40px;" align="center">
                <!-- Divider: table-based, no flex -->
                <table width="100%" cellpadding="0" cellspacing="0" border="0" style="margin-bottom:22px;">
                  <tr>
                    <td width="80" style="padding-right:12px;">
                      <table width="100%" cellpadding="0" cellspacing="0" border="0"><tr>
                        <td height="1" style="background:linear-gradient(90deg,transparent,#c9a882);font-size:1px;line-height:1px;">&nbsp;</td>
                      </tr></table>
                    </td>
                    <td width="20" align="center" style="color:#c9a882;font-size:16px;white-space:nowrap;">✦</td>
                    <td width="80" style="padding-left:12px;">
                      <table width="100%" cellpadding="0" cellspacing="0" border="0"><tr>
                        <td height="1" style="background:linear-gradient(90deg,#c9a882,transparent);font-size:1px;line-height:1px;">&nbsp;</td>
                      </tr></table>
                    </td>
                  </tr>
                </table>
                <h1 style="font-family:'Cormorant Garamond',Georgia,serif;font-size:42px;font-weight:500;font-style:italic;color:#f5ede3;line-height:1.2;letter-spacing:1px;margin-bottom:10px;">Welcome to the Family</h1>
                <p style="font-family:'Jost',sans-serif;font-size:12px;font-weight:500;letter-spacing:3px;text-transform:uppercase;color:#c9a882;">Where every flame tells a story</p>
              </td>
            </tr>

            <!-- ── HERO BAND ── -->
            <tr>
              <td style="background-color:#f0e8de;padding:28px 30px;text-align:center;border-bottom:1px solid #e8ddd2;">
                <span style="font-size:26px;letter-spacing:10px;display:block;margin-bottom:10px;">&#x1F56F;&#xFE0F;&nbsp;&nbsp;&#x2728;&nbsp;&nbsp;&#x1F33F;</span>
                <p style="font-size:11px;font-weight:500;letter-spacing:3px;text-transform:uppercase;color:#9e7a60;">Hand-poured &nbsp;&middot;&nbsp; Small batch &nbsp;&middot;&nbsp; Made with love</p>
              </td>
            </tr>

            <!-- ── BODY ── -->
            <tr>
              <td style="padding:52px 48px;text-align:center;">

                <h2 style="font-family:'Cormorant Garamond',Georgia,serif;font-size:30px;font-weight:500;color:#2c2118;margin-bottom:16px;line-height:1.3;">So glad you&rsquo;re here, <em>{{firstName}}</em>!</h2>
                <p style="font-size:15px;font-weight:300;color:#7a6555;line-height:1.9;margin-bottom:44px;max-width:460px;margin-left:auto;margin-right:auto;">
                  At Naisha Creations, every candle is hand-poured with intention &mdash; crafted to bring warmth,
                  quiet, and beautiful fragrance into your everyday spaces. We&rsquo;re so happy to have you with us.
                </p>

                <!-- Features section label -->
                <p style="font-size:11px;font-weight:600;letter-spacing:3px;text-transform:uppercase;color:#b8a090;margin-bottom:18px;padding-bottom:12px;border-bottom:1px solid #f0e8de;text-align:left;">What makes us different</p>

                <!-- Features grid: 3-column table -->
                <table width="100%" cellpadding="0" cellspacing="0" border="0" style="margin-bottom:44px;border-collapse:collapse;">
                  <tr>
                    <td width="33%" style="padding:28px 16px;text-align:center;vertical-align:top;background-color:#fdf8f3;border:1px solid #ede5da;border-right:none;">
                      <span style="font-size:26px;display:block;margin-bottom:12px;">&#x2728;</span>
                      <p style="font-family:'Cormorant Garamond',Georgia,serif;font-size:16px;font-weight:600;color:#2c2118;margin-bottom:6px;letter-spacing:0.5px;">Hand-Poured</p>
                      <p style="font-size:12px;font-weight:300;color:#9e8878;line-height:1.6;letter-spacing:0.3px;">Each candle crafted individually, never mass-produced</p>
                    </td>
                    <td width="34%" style="padding:28px 16px;text-align:center;vertical-align:top;background-color:#fdf8f3;border:1px solid #ede5da;">
                      <span style="font-size:26px;display:block;margin-bottom:12px;">&#x1F33F;</span>
                      <p style="font-family:'Cormorant Garamond',Georgia,serif;font-size:16px;font-weight:600;color:#2c2118;margin-bottom:6px;letter-spacing:0.5px;">Premium Wax</p>
                      <p style="font-size:12px;font-weight:300;color:#9e8878;line-height:1.6;letter-spacing:0.3px;">Clean-burning, skin-safe ingredients in every batch</p>
                    </td>
                    <td width="33%" style="padding:28px 16px;text-align:center;vertical-align:top;background-color:#fdf8f3;border:1px solid #ede5da;border-left:none;">
                      <span style="font-size:26px;display:block;margin-bottom:12px;">&#x1F3A8;</span>
                      <p style="font-family:'Cormorant Garamond',Georgia,serif;font-size:16px;font-weight:600;color:#2c2118;margin-bottom:6px;letter-spacing:0.5px;">Customisable</p>
                      <p style="font-size:12px;font-weight:300;color:#9e8878;line-height:1.6;letter-spacing:0.3px;">Bespoke scents, labels, and gifting options available</p>
                    </td>
                  </tr>
                </table>

                <!-- Account perks box -->
                <table width="100%" cellpadding="0" cellspacing="0" border="0" style="background-color:#fdf3ec;border-left:3px solid #c9a882;margin-bottom:40px;">
                  <tr>
                    <td style="padding:20px 22px;text-align:left;">
                      <p style="font-family:'Cormorant Garamond',Georgia,serif;font-size:17px;font-weight:600;color:#3d1f1f;margin-bottom:10px;">Your account is all set up</p>
                      <table cellpadding="0" cellspacing="0" border="0" width="100%">
                        <tr><td style="padding:4px 0 4px 18px;font-size:14px;font-weight:300;color:#7a6555;line-height:1.8;position:relative;">&#10022;&nbsp;&nbsp;Track all your orders in one place</td></tr>
                        <tr><td style="padding:4px 0 4px 18px;font-size:14px;font-weight:300;color:#7a6555;line-height:1.8;">&#10022;&nbsp;&nbsp;Save your favourite delivery addresses</td></tr>
                        <tr><td style="padding:4px 0 4px 18px;font-size:14px;font-weight:300;color:#7a6555;line-height:1.8;">&#10022;&nbsp;&nbsp;Request custom and bulk orders with ease</td></tr>
                        <tr><td style="padding:4px 0 4px 18px;font-size:14px;font-weight:300;color:#7a6555;line-height:1.8;">&#10022;&nbsp;&nbsp;Get early access to new collections &amp; offers</td></tr>
                      </table>
                    </td>
                  </tr>
                </table>

                <!-- CTA -->
                <table width="100%" cellpadding="0" cellspacing="0" border="0" style="margin-bottom:8px;">
                  <tr>
                    <td align="center">
                      <a href="{{frontendUrl}}/collections" style="display:inline-block;padding:16px 44px;background-color:#3d1f1f;color:#f5ede3;text-decoration:none;font-size:12px;font-weight:600;letter-spacing:3px;text-transform:uppercase;">Shop Our Collection</a>
                    </td>
                  </tr>
                </table>

              </td>
            </tr>

            <!-- ── FOOTER DIVIDER ── -->
            <tr>
              <td style="padding:0 48px;">
                <hr style="border:none;border-top:1px solid #e0d2c2;" />
              </td>
            </tr>

            <!-- ── FOOTER ── -->
            <tr>
              <td style="padding:40px 48px;text-align:center;">
                <p style="font-family:'Cormorant Garamond',Georgia,serif;font-size:20px;font-weight:500;font-style:italic;color:#3d1f1f;letter-spacing:2px;margin-bottom:14px;">Naisha Creations</p>
                <p style="font-size:11px;font-weight:300;letter-spacing:2px;text-transform:uppercase;color:#b8a090;margin-bottom:24px;">Handcrafted &middot; Thoughtful &middot; Made with love</p>

                <!-- Social icons: table-based, Unicode emoji -->
                <table cellpadding="0" cellspacing="0" border="0" style="margin:0 auto 24px;">
                  <tr>
                    <td style="padding:0 8px;">
                      <a href="https://instagram.com/naishacreations_withlove" title="Instagram" style="display:inline-block;width:38px;height:38px;line-height:36px;text-align:center;border:1px solid #d4c4b0;border-radius:50%;color:#7a5c3a;text-decoration:none;font-size:18px;">&#128247;</a>
                    </td>
                    <td style="padding:0 8px;">
                      <a href="{{frontendUrl}}" title="Website" style="display:inline-block;width:38px;height:38px;line-height:36px;text-align:center;border:1px solid #d4c4b0;border-radius:50%;color:#7a5c3a;text-decoration:none;font-size:18px;">&#127760;</a>
                    </td>
                  </tr>
                </table>

                <p class="footer-legal">
                  &copy; {{year}} Naisha Creations. All rights reserved.<br />
                  Questions? Reply to this email or write to us at
                  <a href="mailto:support@naishacreations.com" style="color:#9e7a60;text-decoration:none;">support@naishacreations.com</a>
                </p>
              </td>
            </tr>

          </table><!-- /email-container -->
        </td>
      </tr>
    </table><!-- /outer wrapper -->
  </div>
</body>
</html>