# ============================================
# BACKEND ENVIRONMENT VARIABLES
# ============================================

PORT=3000
NODE_ENV=development  # development or production

# URLs
FRONTEND_URL_DEV=http://localhost:5173
FRONTEND_URL_PROD=https://your-domain.com
ADMIN_URL_DEV=http://localhost:5174
ADMIN_URL_PROD=https://admin.your-domain.com

# Database
MONGO_URI=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/dbname

# JWT
SECRET_KEY=your-jwt-secret-key-here

# SMTP (Email)
SMTP_HOST=mail.your-domain.com
SMTP_PORT=465
SMTP_USER=info@your-domain.com
SMTP_PASS=your-smtp-password
SMTP_FROM_EMAIL=noreply@your-domain.com

# Twilio (if using)
TWILIO_SID=your-twilio-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_SERVICE_SID=your-twilio-service-sid

# MSG91 (SMS/OTP)
MSG91_AUTH_KEY=your-msg91-auth-key
MSG91_SENDER_ID=YOURID
MSG91_OTP_TEMPLATE_ID=your-otp-template-id
# MSG91_ORDER_CONFIRM_TEMPLATE_ID=
# MSG91_ORDER_STATUS_TEMPLATE_ID=

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
CLIENT_SECRET=your-google-client-secret

# Cloudinary
CLOUD_NAME=your-cloud-name
CLOUD_API_KEY=your-cloud-api-key
CLOUD_API_SECRET=your-cloud-api-secret

# Razorpay
RAZORPAY_KEY_ID=rzp_test_XXXXXXXXXXXXXX
RAZORPAY_KEY_SECRET=your-razorpay-key-secret
RAZORPAY_WEBHOOK_SECRET=your-razorpay-webhook-secret

# Shiprocket
SHIPROCKET_EMAIL=admin@your-domain.com
SHIPROCKET_PASSWORD=your-shiprocket-password
SHIPROCKET_WEBHOOK_TOKEN=your-shiprocket-webhook-token
SHIPROCKET_PICKUP_PINCODE=000000

# Sentry
SENTRY_DSN=

# Slack Webhook
SLACK_WEBHOOK_URL=